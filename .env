# ECHO explainer (optional). Without these, ECHO uses the deterministic plain-words text.
# --- Local Ollama (offline) ---
ECHO_LLM_PROVIDER=ollama
ECHO_LLM_BASE_URL=http://localhost:11434/v1
ECHO_LLM_MODEL=llama3.2
# Ollama needs no key. Leave empty (ECHO sends the placeholder "ollama").
ECHO_LLM_API_KEY=
ECHO_LLM_TIMEOUT=40
ECHO_LLM_TEMPERATURE=0.1
ECHO_LLM_MAX_TOKENS=700

# --- Hosted alternatives ---
# ECHO_LLM_PROVIDER=openai      (+ OPENAI_API_KEY or ECHO_LLM_API_KEY, default timeout 15)
# ECHO_LLM_PROVIDER=anthropic   (+ ANTHROPIC_API_KEY or ECHO_LLM_API_KEY)

# API / sandbox
# ECHO_TIMEOUT_SECONDS=15
# ECHO_SANDBOX=1
# ECHO_CORS_ORIGINS=*

DATABASE_URL=postgresql://postgres:SH_database@localhost:5432/echo
